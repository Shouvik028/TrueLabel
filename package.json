{
  "name": "truelabel",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "mobile:tunnel": "npm run start:tunnel --workspace apps/mobile",
    "admin": "npm run dev --workspace apps/admin",
    "test": "npm run test --workspace packages/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
